# Keep repository text files deterministic across Windows and CI.
* text=auto

.gitattributes text eol=lf
.gitignore     text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.rs   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.lock text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
