{
  "name": "astian",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "benchmark:editor": "vitest bench --run src/editor/markdownPreview.bench.ts",
    "benchmark:search": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin fts_benchmark",
    "spike:git-status": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin git_status_spike",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@tauri-apps/api": "^2",
    "codemirror": "^6.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "4.1.11"
  }
}
